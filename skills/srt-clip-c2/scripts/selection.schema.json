{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2-universal.local/schemas/selection-0.4.26.json",
  "title": "C2 Selection JSON",
  "description": "Semantic record for one user-selected final cut. Selling points describe the complete product pool; selected_ids and roles describe only this cut. Opening choice is an AI record, not a machine judgment. A pending multi-video choice is saved in the current conversation and does not create a selection record or JSON gate.",
  "type": "object",
  "required": [
    "verification_mode",
    "source_sha256",
    "selected_ids",
    "selling_points",
    "roles",
    "flags"
  ],
  "properties": {
    "verification_mode": {
      "enum": [
        "script",
        "manual"
      ],
      "description": "script means the optional helper was run; manual never claims a machine pass."
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "selected_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Source cue IDs for one user-selected final cut, ordered for playback. Create one selection record per selected cut."
    },
    "selling_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "support_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "support_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "necessary_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_condition_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "description": "The complete valid independent purchase-information pool for this product. Each selected cut must independently cover every point and its required evidence/conditions."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "role"
        ],
        "properties": {
          "cue_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "独立卖点",
              "证据",
              "条件",
              "必要衔接",
              "适用促单原话"
            ],
            "description": "适用促单原话必须来自原文；适用于当前商品和成片且符合规则时完整保留，不得编造、改写、补充或跨商品移用。"
          }
        },
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "cue_ids",
          "note"
        ],
        "properties": {
          "type": {
            "enum": [
              "fact_pending",
              "risk_hint",
              "key_limit"
            ]
          },
          "cue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "hard_rule_outcomes": {
      "type": "array",
      "description": "AI-recorded hard-rule conclusions for semantic replay comparison; the diff utility reports changes but does not judge them.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "status"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "cue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "opening_choice": {
      "type": "object",
      "description": "AI-only record of the selected opening. Comparison is empathy-first and covers opening candidates only, never full cuts.",
      "properties": {
        "cue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "enum": [
            "empathy",
            "direct_response",
            "specific_benefit",
            "verifiable_product_fact"
          ]
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "known_unaccelerated_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional estimate supplement for display only; duration remains approximate and is never used for acceptance, pause, or splitting."
    }
  },
  "additionalProperties": true
}
