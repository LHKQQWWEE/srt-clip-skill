{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2-universal.local/schemas/selection-0.4.24.json",
  "title": "C2 Selection JSON",
  "description": "Shared mechanical input for optional validation, assembly, duration, fifth-part sequence, and semantic replay diff. The schema does not judge selling-point completeness or semantic support.",
  "type": "object",
  "required": [
    "verification_mode",
    "source_sha256",
    "selected_ids",
    "selling_points",
    "roles",
    "flags"
  ],
  "properties": {
    "verification_mode": {
      "enum": ["script", "manual"],
      "description": "script means the optional helper was run; manual never claims a machine pass."
    },
    "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "selected_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "selling_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "support_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "support_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "necessary_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "required_condition_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cue_id", "role"],
        "properties": {
          "cue_id": {"type": "string"},
          "role": {"enum": ["独立卖点", "证据", "条件", "必要衔接", "可选行动句"]}
        },
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "cue_ids", "note"],
        "properties": {
          "type": {"enum": ["fact_pending", "risk_hint", "key_limit"]},
          "cue_ids": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "hard_rule_outcomes": {
      "type": "array",
      "description": "AI-recorded hard-rule conclusions for semantic replay comparison; the diff utility reports changes but does not judge them.",
      "items": {
        "type": "object",
        "required": ["rule_id", "status"],
        "properties": {
          "rule_id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "cue_ids": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "candidate_angle": {"type": "string"},
    "known_unaccelerated_ms": {"type": "integer", "minimum": 0},
    "jump_checks": {
      "type": "array",
      "description": "AI-only, source-verified checks at each source discontinuity in the ordered candidate path.",
      "items": {
        "type": "object",
        "required": ["prev_id", "next_id", "referent_continuity", "object_continuity", "condition_continuity", "eligible"],
        "properties": {
          "prev_id": {"type": "string"},
          "next_id": {"type": "string"},
          "referent_continuity": {"type": "boolean"},
          "object_continuity": {"type": "boolean"},
          "condition_continuity": {"type": "boolean"},
          "eligible": {"type": "boolean"},
          "source_evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "candidate_comparison": {
      "type": "array",
      "description": "Compact full-path candidate records. Losing candidates retain ordered IDs, angle, point mapping, necessary evidence/conditions, source-checked jump checks, and six-dimension results; their transcript text is not copied or expanded.",
      "items": {
        "type": "object",
        "required": ["candidate_id", "angle", "eligible", "complete_ordered_sequence", "point_map", "jump_checks", "six_dimension_results"],
        "properties": {
          "candidate_id": {"type": "string"},
          "angle": {"type": "string", "description": "One sentence describing this candidate's path."},
          "eligible": {"type": "boolean"},
          "complete_ordered_sequence": {"type": "array", "items": {"type": "string"}},
          "point_map": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["point_id", "support_ids", "necessary_evidence_ids", "required_condition_ids"],
              "properties": {
                "point_id": {"type": "string"},
                "support_ids": {"type": "array", "items": {"type": "string"}},
                "necessary_evidence_ids": {"type": "array", "items": {"type": "string"}},
                "required_condition_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "jump_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["prev_id", "next_id", "referent_continuity", "object_continuity", "condition_continuity", "eligible"],
              "properties": {
                "prev_id": {"type": "string"},
                "next_id": {"type": "string"},
                "referent_continuity": {"type": "boolean"},
                "object_continuity": {"type": "boolean"},
                "condition_continuity": {"type": "boolean"},
                "eligible": {"type": "boolean"},
                "source_evidence": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "six_dimension_results": {
            "type": "object",
            "required": ["customer_problem_strength", "first_screen_value", "core_reason_completeness", "full_point_naturalness", "narrative_continuity", "decision_efficiency"],
            "properties": {
              "customer_problem_strength": {"type": "number"},
              "first_screen_value": {"type": "number"},
              "core_reason_completeness": {"type": "number"},
              "full_point_naturalness": {"type": "number"},
              "narrative_continuity": {"type": "number"},
              "decision_efficiency": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
